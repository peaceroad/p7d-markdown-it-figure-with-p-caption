{
  "name": "@peaceroad/markdown-it-figure-with-p-caption",
  "version": "0.20.0",
  "description": "A markdown-it plugin. For a paragraph with only one image, a table or code block or blockquote, and by writing a caption paragraph immediately before or after, they are converted into the figure element with the figcaption element.",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "test": "npm run test:core && npm run test:numbering && npm run test:numbering-api",
    "test:core": "node test/test.js",
    "test:numbering": "node test/test-caption-numbering.js",
    "test:numbering-api": "node test/test-caption-numbering-api.js",
    "test:p-captions": "node test/test-p-captions.js",
    "test:all": "npm run test && npm run test:p-captions",
    "perf": "node test/performance/benchmark.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/peaceroad/p7d-markdown-it-figure-with-p-caption.git"
  },
  "author": "peaceroad <peaceroad@gmail.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/peaceroad/p7d-markdown-it-figure-with-p-caption/issues"
  },
  "devDependencies": {
    "@peaceroad/markdown-it-cjk-breaks-mod": "^0.1.14",
    "@peaceroad/markdown-it-renderer-fence": "^0.9.0",
    "@peaceroad/markdown-it-renderer-image": "^0.16.1",
    "@peaceroad/markdown-it-strong-ja": "^0.9.4",
    "highlight.js": "^11.11.1",
    "markdown-it": "^14.3.0",
    "markdown-it-attrs": "^5.0.0",
    "markdown-it-front-matter": "^0.2.4"
  },
  "dependencies": {
    "p7d-markdown-it-p-captions": "0.25.0"
  },
  "files": [
    "index.js",
    "caption-numbering.js",
    "caption-numbering/",
    "embeds/",
    "README.md",
    "LICENSE"
  ]
}
