{
  "name": "@peaceroad/markdown-it-figure-with-p-caption",
  "version": "0.21.0",
  "description": "A markdown-it plugin that wraps captioned media in semantic figures with optional annotations and target-local figure/table notes.",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "test": "npm run test:suites && node -e \"console.log('\\nAll tests passed.')\"",
    "test:suites": "npm run test:core && npm run test:numbering && npm run test:numbering-api && npm run test:notes && npm run test:docs",
    "test:core": "node test/test.js",
    "test:numbering": "node test/test-caption-numbering.js",
    "test:numbering-api": "node test/test-caption-numbering-api.js",
    "test:notes": "node test/test-notes.js",
    "test:docs": "node test/test-doc-examples.js",
    "test:p-captions": "node test/test-p-captions.js",
    "test:all": "npm run test:suites && npm run test:p-captions && node -e \"console.log('\\nAll tests passed.')\"",
    "perf": "node test/performance/benchmark.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/peaceroad/p7d-markdown-it-figure-with-p-caption.git"
  },
  "author": "peaceroad <peaceroad@gmail.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/peaceroad/p7d-markdown-it-figure-with-p-caption/issues"
  },
  "devDependencies": {
    "@peaceroad/markdown-it-cjk-breaks-mod": "^0.2.0",
    "@peaceroad/markdown-it-hr-sandwiched-semantic-container": "^0.14.0",
    "@peaceroad/markdown-it-renderer-fence": "^0.9.1",
    "@peaceroad/markdown-it-renderer-image": "^0.17.1",
    "@peaceroad/markdown-it-strong-ja": "^0.10.0",
    "highlight.js": "^11.12.0",
    "markdown-it": "^15.0.1",
    "markdown-it-attrs": "^5.0.1",
    "markdown-it-front-matter": "^0.2.4"
  },
  "dependencies": {
    "@peaceroad/markdown-it-footnote-here": "^0.8.0",
    "p7d-markdown-it-p-captions": "0.26.0"
  },
  "files": [
    "index.js",
    "caption-numbering.js",
    "caption-numbering/",
    "docs/",
    "embeds/",
    "notes/",
    "README.md",
    "LICENSE"
  ]
}
